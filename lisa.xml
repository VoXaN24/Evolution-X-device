<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!--Remotes-->
    <remote name="los"            fetch="https://github.com/LineageOS"           revision="lineage-23.2" />
    <remote name="muppets"        fetch="https://github.com/TheMuppets"          revision="lineage-23.2" />
    <remote name="voxan"          fetch="https://github.com/VoXaN24"             revision="bka-lisa" />

    <!--Devices Trees-->
    <project name="android_device_xiaomi_lisa"           path="device/xiaomi/lisa"       remote="los" />
    <project name="android_device_xiaomi_sm8350-common"     path="device/xiaomi/sm8350-common" remote="los" />

    <!--Vendors Tree-->
    <project name="proprietary_vendor_xiaomi_lisa"       path="vendor/xiaomi/lisa"       remote="muppets" />
    <project name="proprietary_vendor_xiaomi_sm8350-common" path="vendor/xiaomi/sm8350-common" remote="muppets" />

    <!--Kernel Tree-->
    <project name="android_kernel_xiaomi_sm8350"            path="kernel/xiaomi/sm8350"        remote="los" />

    <!--Hardware dependencies-->
    <project name="android_hardware_xiaomi"                 path="hardware/xiaomi"             remote="los" />

    <!-- Updater-->
    <project name="packages_apps_Updater"                   path="packages/apps/Updater"        remote="voxan" />
</manifest>